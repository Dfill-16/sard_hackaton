APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# SARD — Configuración del módulo de eventos (ver contratos/config.md)
# =============================================================================
# Identidad y topología del nodo (uno por proceso):
#   NODE_ROLE=A|B|C|CANAL|D
#   APP_PORT=8001|8002|8003|8004|8010
#   DB_DATABASE=database/nodo_a.sqlite | nodo_b.sqlite | nodo_c.sqlite | nodo_d.sqlite | canal.sqlite
#   SARD_URL_A=http://127.0.0.1:8001
#   SARD_URL_B=http://127.0.0.1:8002
#   SARD_URL_C=http://127.0.0.1:8003
#   SARD_URL_D=http://127.0.0.1:8004
#   SARD_URL_CANAL=http://127.0.0.1:8010
#   SARD_LIDER_INICIAL=B
#   SARD_DEMO=true
#
# Parámetros (valores de demo, ver contratos/parametros.md):
#   CANAL_PERDIDA=0.30
#   CANAL_LAT_MIN_MS=200
#   CANAL_LAT_MAX_MS=3000
#   CANAL_DESORDEN=0.20
#   CANAL_VENTANA_ABIERTA_S=5
#   CANAL_VENTANA_CERRADA_S=15
#   CANAL_MTU_B=200
#   CANAL_SEMILLA=42
#   CANAL_SALTOS=1
#   BACKOFF_SERIE=1,2,4,8,16,30
#   BACKOFF_JITTER=0.2
#   A4_ENVEJ_MIN=5
#   A4_ENVEJ_TOPE=5
#   B_ENVEJ_MIN=10
#   B_ENVEJ_TOPE=P2
#   PWA_VENTANA_REPETIDO_MIN=10
#   DBSCAN_EPS_M=300
#   DBSCAN_MIN=2
#   VENTANA_MIN=30
#   MASIVO_DISPOSITIVOS=5
#   LATIDO_S=1
#   LATIDOS_PERDIDOS=10
#   REPLICA_S=1
#   POLLING_TABLERO_S=2
#
# SQLite (aplicado al conectar):
#   DB_JOURNAL_MODE=wal
#   DB_BUSY_TIMEOUT=5000
#   DB_SYNCHRONOUS=normal
#
# LLM opcional (capa 7, T-016). Las claves van SOLO en .env, nunca en el repositorio.
#   LLM_HABILITADO=false
#   LLM_TIMEOUT_S=5
#   LLM_1_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_1_KEY=
#   LLM_1_MODELO=gemini-3.5-flash-lite
#   LLM_2_URL=https://openrouter.ai/api/v1
#   LLM_2_KEY=
#   LLM_2_MODELO=google/gemma-4-31b-it:free
#   LLM_3_URL=https://integrate.api.nvidia.com/v1
#   LLM_3_KEY=
#   LLM_3_MODELO=nvidia/nemotron-3.5-lightning-30b-a3b
#
# Acceso en código: siempre config('sard.<clave>'); nunca env() fuera de config/.
# =============================================================================
